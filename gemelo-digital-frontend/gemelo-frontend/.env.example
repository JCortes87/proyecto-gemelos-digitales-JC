# Copia este archivo a .env para desarrollo local (no se versiona).
# OJO: toda variable VITE_* queda embebida en el bundle público. Nunca
# pongas aquí secretos (API keys, contraseñas, tokens).

# URL absoluta del backend. En dev local déjala vacía: Vite hace proxy a
# https://localhost:8000. El build de producción la toma de .env.production.
VITE_API_BASE_URL=

# IDs de Brightspace (separados por coma) con acceso de super-admin en la UI.
VITE_SUPERADMIN_IDS=
